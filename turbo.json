{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                "build/**",
                "../dist/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "!.turbo/**"
            ]
        },
        "test": {
            "dependsOn": [
                "build"
            ],
            "outputs": []
        },
        "watch": {
            "cache": false,
            "persistent": true
        }
    }
}
