{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react"
    },
    "include": [
        "*.ts",
        "*.tsx",
        "wasm.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}