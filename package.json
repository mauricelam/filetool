{
    "name": "filemagic",
    "workspaces": [
        "archive",
        "binaryxml",
        "binutils",
        "bplistviewer",
        "browser",
        "cborviewer",
        "cyberchef",
        "cheerpj",
        "classfile",
        "classyshark",
        "der",
        "dexviewer",
        "dmg-viewer",
        "esbuild-plugins",
        "ffmpeg",
        "file-type-detector",
        "filemagic-common",
        "graphviz",
        "hex_viewer",
        "imagemagick",
        "jqviewer",
        "lzfse-wasm",
        "lzfse",
        "main",
        "markdown",
        "mhtml",
        "pdfjs",
        "proguardviewer",
        "protoscope",
        "rstviewer",
        "sqliteviewer",
        "textviewer",
        "wat_viewer",
        "webgl_previewer",
        "img-viewer"
    ],
    "scripts": {
        "start": "node serve.mts",
        "build:workspaces": "npm run build --workspaces",
        "watch:workspaces": "npm pkg get name --ws | jq -c -r 'keys | .[]' | xargs -P 99 -I {} npm run watch --silent -w {}",
        "serve": "run-p --silent \"watch:workspaces\" start",
        "build": "npm run build:workspaces",
        "test": "npm run test --workspaces --if-present",
        "test:integration": "npm run build && node tests/integration/build.mjs && playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/express": "^5.0.6",
        "@types/finalhandler": "^1.2.3",
        "@types/jest": "^29.5.14",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@types/react-table": "^7.7.20",
        "@types/serve-static": "^1.15.7",
        "esbuild-plugin-copy": "^2.1.1",
        "esbuild-plugin-wasm": "^1.1.0",
        "express": "^5.2.1",
        "finalhandler": "^1.3.2",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.0.0-beta.3",
        "jsdom": "^24.0.0",
        "npm-run-all": "^4.1.5",
        "serve-static": "^1.16.2",
        "ts-jest": "^29.4.5",
        "typescript": "^5.5.4",
        "vitest": "4.0.16"
    },
    "dependencies": {
        "jq-wasm": "^1.1.0-jq-1.7.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-syntax-highlighter": "^16.1.0",
        "vite": "7.3.1",
        "wabt": "^1.0.36"
    },
    "license": "MIT",
    "description": ""
}